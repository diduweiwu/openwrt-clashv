#!/bin/sh /etc/rc.common
# clashv 开机自启脚本（procd 托管）
# mihomo 内核由 clashv 进程自己管理，procd 只监管 clashv 本身。

USE_PROCD=1
START=99
STOP=15

PROG=/usr/bin/clashv

start_service() {
	local enabled
	enabled="$(uci -q get clashv.main.enabled || echo 0)"
	[ "$enabled" = "1" ] || return 0

	# 清理上次异常退出残留的内核进程（避免 cache.db 与端口占用）
	killall -q mihomo 2>/dev/null

	procd_open_instance clashv
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

stop_service() {
	# procd 杀服务进程前，记下内核是否还在运行（写 core.state 运行记忆）。
	# 升级/重启服务/关机都走这里：插件进程马上会被杀，它自己来不及可靠记账
	# （退出回收可能来不及执行，也可能错把「外部被杀」当成主动停止清掉记忆），
	# 由 init 脚本在杀进程前快照最可靠。新服务实例启动后 autoStartCore
	# 据此自动恢复内核。
	local workdir core
	workdir="$(uci -q get clashv.main.workdir)"
	[ -n "$workdir" ] || workdir=/etc/clashv
	core="$(uci -q get clashv.main.core_path)"
	[ -n "$core" ] || core=/usr/bin/mihomo
	if pgrep -f "$core" >/dev/null 2>&1; then
		mkdir -p "$workdir"
		echo running > "$workdir/core.state"
	fi
}

reload_service() {
	# 设置里改了界面端口/令牌后，用 /etc/init.d/clashv reload 重新拉起
	stop
	start
}
