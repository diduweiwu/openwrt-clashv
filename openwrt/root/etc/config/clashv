# clashv UCI 默认配置
# 首次安装时由 uci-defaults 写入

config clashv 'main'
	option enabled '1'
	option ui_port '9097'
	option mixed_port '7890'
	option controller_port '9090'
	option controller_secret ''
	option token ''
	option tun '0'
	option tun_stack 'mixed'
	option dns '1'
	option auto_update_days '0,1,2,3,4,5,6'
	option auto_update_time '04:00'
	option core_path '/usr/bin/mihomo'
	option core_arch ''
	option workdir '/etc/clashv'
	option plugin_repo 'nier/clashv'
	option active_profile ''
